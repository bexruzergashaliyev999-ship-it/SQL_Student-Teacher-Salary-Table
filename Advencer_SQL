    if oqituvchilar_soni < 10:
        ism = input("Teacher's first name: ")
        familiya = input("Teacher's last name: ")
        sertifikat = input("Teacher's certificate (ielts, cefr, toefl): ")
        fan = input("Teacher's subject: ")
        oylik = int(input("Teacher's salary: "))

        cursor.execute(
            '''INSERT INTO oqituvchilar(ism, familiya, sertifikat, oylik, fan) VALUES (?,?,?,?,?)''',
            (ism, familiya, sertifikat, oylik, fan),
        )

